ErrorDocument 403 /error-403/
ErrorDocument 404 /error-404/

Header set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' 'unsafe-inline' *.sfml-dev.org www.gstatic.com www.google.com www.google-analytics.com ssl.google-analytics.com; connect-src 'self' www.google-analytics.com api.github.com; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' *.sfml-dev.org fonts.googleapis.com; media-src https: data:; font-src 'self' fonts.gstatic.com; base-uri 'self'; form-action 'self'; frame-src https: data:"

RewriteEngine On

# Append the www. prefix for all sites except en.*/fr.*/mirror1.* subdomains
RewriteCond %{HTTP_HOST} !^www\.
RewriteCond %{HTTP_HOST} !^en\. [NC]
RewriteCond %{HTTP_HOST} !^fr\. [NC]
RewriteCond %{HTTP_HOST} !^mirror1\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force https:// for all except some selected URLs    
RewriteCond %{HTTPS} off
RewriteCond %{THE_REQUEST} !/ip-provider.php [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force http:// for selected URLs
RewriteCond %{HTTPS} on
RewriteCond %{THE_REQUEST} /ip-provider.php [NC]
RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Documentation redirects
RewriteCond %{REQUEST_URI} ^/documentation(/?)(\.php)?$
RewriteRule ^ /documentation/latest/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/documentation/latest(/?)(.*)$
RewriteRule /latest(/?)(.*) /documentation/3.1.0/$2 [R=301,L]

# SFML 1.6 and 2.x documentation moved from PHP to HTML, the French copies were the same API documentation
RewriteRule ^documentation/(1\.6|2\.[0-9.]+?)(-fr)?/(.+)\.php$ /documentation/$1/$3.html [R=301,L]
RewriteRule ^documentation/(1\.6|2\.[0-9.]+?)-fr(/?)$ /documentation/$1/ [R=301,L]

# Tutorial redirects
RewriteCond %{REQUEST_URI} ^/tutorials(/?)(\.php)?$
RewriteRule ^ /tutorials/latest/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/tutorials/latest(/?)(.*)$
RewriteRule /latest(/?)(.*) /tutorials/3.1/$2 [R=301,L]

RewriteCond %{REQUEST_URI} ^/fr/tutorials/latest(/?)(.*)$
RewriteRule /latest(/?)(.*) /fr/tutorials/3.1/$2 [R=301,L]

# Artifact redirects
RewriteCond %{REQUEST_URI} ^/artifacts(/?)(.*)?$
RewriteRule ^ https://artifacts.sfml-dev.org/by-branch/master/ [R=301,L]

# Pre-MkDocs redirects
RewriteCond %{REQUEST_URI} ^/index\.php$
RewriteRule ^ / [R=301,L]
RewriteCond %{REQUEST_URI} ^/index-fr\.php$
RewriteRule ^ /fr/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/learn\.php$
RewriteRule ^ /learn/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/learn-fr\.php$
RewriteRule ^ /fr/learn/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/license\.php$
RewriteRule ^ /license/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/license-fr\.php$
RewriteRule ^ /fr/license/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/faq\.php$
RewriteRule ^ /faq/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/faq-fr\.php$
RewriteRule ^ /fr/faq/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/community\.php$
RewriteRule ^ /community/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/community-fr\.php$
RewriteRule ^ /fr/community/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/donation-(ok|cancel)\.php$
RewriteRule ^ /donate/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/donation-(ok|cancel)-fr\.php$
RewriteRule ^ /fr/donate/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/development\.php$
RewriteRule ^ /development/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/development-fr\.php$
RewriteRule ^ /fr/development/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/issues\.php$
RewriteRule ^ /development/issues/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/issues-fr\.php$
RewriteRule ^ /fr/development/issues/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/changelog\.php$
RewriteRule ^ /development/changelog/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/changelog-fr\.php$
RewriteRule ^ /fr/development/changelog/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/contribute\.php$
RewriteRule ^ /development/contribute/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/contribute-fr\.php$
RewriteRule ^ /fr/development/contribute/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/style\.php$
RewriteRule ^ /development/style/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/style-fr\.php$
RewriteRule ^ /fr/development/style/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/workflow\.php$
RewriteRule ^ /development/workflow/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/workflow-fr\.php$
RewriteRule ^ /fr/development/workflow/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download\.php$
RewriteRule ^ /download/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download-fr\.php$
RewriteRule ^ /fr/download/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/bindings\.php$
RewriteRule ^ /download/bindings/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/bindings-fr\.php$
RewriteRule ^ /fr/download/bindings/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/goodies/index\.php$
RewriteRule ^ /download/goodies/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/goodies/index-fr\.php$
RewriteRule ^ /fr/download/goodies/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/csfml/index\.php$
RewriteRule ^ /download/csfml/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/csfml/index-fr\.php$
RewriteRule ^ /fr/download/csfml/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml\.net/index\.php$
RewriteRule ^ /download/sfml.net/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml\.net/index-fr\.php$
RewriteRule ^ /fr/download/sfml.net/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/old-versions\.php$
RewriteRule ^ /download/sfml/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/old-versions-fr\.php$
RewriteRule ^ /fr/download/sfml/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/1\.6(/index\.php)?$
RewriteRule ^ /download/sfml/1.6/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/1\.6/index-fr\.php$
RewriteRule ^ /fr/download/sfml/1.6/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.0(/index\.php)?$
RewriteRule ^ /download/sfml/2.0/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.0/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.0/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.1(/index\.php)?$
RewriteRule ^ /download/sfml/2.1/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.1/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.1/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.2(/index\.php)?$
RewriteRule ^ /download/sfml/2.2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.2/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.2/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3(/index\.php)?$
RewriteRule ^ /download/sfml/2.3/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.3/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3\.1(/index\.php)?$
RewriteRule ^ /download/sfml/2.3.1/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3\.1/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.3.1/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3\.2(/index\.php)?$
RewriteRule ^ /download/sfml/2.3.2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.3\.2/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.3.2/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.0(/index\.php)?$
RewriteRule ^ /download/sfml/2.4.0/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.0/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.4.0/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.1(/index\.php)?$
RewriteRule ^ /download/sfml/2.4.1/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.1/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.4.1/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.2(/index\.php)?$
RewriteRule ^ /download/sfml/2.4.2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.4\.2/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.4.2/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.5\.0(/index\.php)?$
RewriteRule ^ /download/sfml/2.5.0/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.5\.0/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.5.0/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.5\.1(/index\.php)?$
RewriteRule ^ /download/sfml/2.5.1/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.5\.1/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.5.1/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.0(/index\.php)?$
RewriteRule ^ /download/sfml/2.6.0/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.0/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.6.0/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.1(/index\.php)?$
RewriteRule ^ /download/sfml/2.6.1/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.1/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.6.1/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.2(/index\.php)?$
RewriteRule ^ /download/sfml/2.6.2/ [R=301,L]
RewriteCond %{REQUEST_URI} ^/download/sfml/2\.6\.2/index-fr\.php$
RewriteRule ^ /fr/download/sfml/2.6.2/ [R=301,L]

# Tutorial redirects from the pre-MkDocs pages, French rules have to come first
RewriteRule ^tutorials/(1\.6|2\.[0-6])(/index\.php)?$ /tutorials/$1/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/index-fr\.php$ /fr/tutorials/$1/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/(system|window|graphics|audio|network)-([a-z0-9-]+)-fr\.php$ /fr/tutorials/$1/$2/$3/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/(system|window|graphics|audio|network)-([a-z0-9-]+)\.php$ /tutorials/$1/$2/$3/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-cmake-fr\.php$ /fr/tutorials/$1/getting-started/cmake/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-cmake\.php$ /tutorials/$1/getting-started/cmake/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-vc-fr\.php$ /fr/tutorials/$1/getting-started/visual-studio/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-vc\.php$ /tutorials/$1/getting-started/visual-studio/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-cb-fr\.php$ /fr/tutorials/$1/getting-started/code-blocks/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-cb\.php$ /tutorials/$1/getting-started/code-blocks/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-linux-fr\.php$ /fr/tutorials/$1/getting-started/linux/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-linux\.php$ /tutorials/$1/getting-started/linux/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-osx-fr\.php$ /fr/tutorials/$1/getting-started/macos/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-osx\.php$ /tutorials/$1/getting-started/macos/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-python-fr\.php$ /fr/tutorials/$1/getting-started/python/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-python\.php$ /tutorials/$1/getting-started/python/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-ruby-fr\.php$ /fr/tutorials/$1/getting-started/ruby/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/start-ruby\.php$ /tutorials/$1/getting-started/ruby/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/compile-with-cmake-fr\.php$ /fr/tutorials/$1/getting-started/build-from-source/ [R=301,L]
RewriteRule ^tutorials/(1\.6|2\.[0-6])/compile-with-cmake\.php$ /tutorials/$1/getting-started/build-from-source/ [R=301,L]
